# Yönetim paneli (/admin). Yerelde .env.local'e, üretimde Vercel proje ayarlarına girilir.
# Bu dosya şablondur — gerçek değerleri buraya YAZMA, .env.local git'e girmiyor.

# Panele giriş parolası.
ADMIN_PASSWORD=

# Oturum çerezini imzalayan gizli anahtar. En az 32 karakter.
# Üretmek için: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# İçerik commit'leri için GitHub token'ı.
# Fine-grained PAT, yalnız bu repo'ya, "Contents: Read and write" yetkisiyle.
GITHUB_TOKEN=

# sahip/repo
GITHUB_REPO=j4velinusa/claviscore

# İçeriğin commit'leneceği dal (varsayılan: main)
GITHUB_BRANCH=main

# Kanonik site adresi (sitemap/robots/OG için). Vercel'de otomatik türetilir.
# NEXT_PUBLIC_SITE_URL=https://claviscor.com
